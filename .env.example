# 브라우저에 노출되는 값만 넣습니다.
# Supabase service_role 키, 지갑 시드, 개인 키는 절대 넣지 않습니다.

# Supabase Auth / PostgreSQL / Realtime
# 둘 다 있어야 이메일 OTP 로그인이 동작합니다. 비어 있으면 로그인하지 않습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 비밀 변수. 브라우저 .env에 값을 넣지 않습니다.
# Edge Function 배포 전에 설정합니다.
#   openssl rand -base64 32
#   supabase secrets set WALLET_ENCRYPTION_KEY='생성된 값'
# SUPABASE_SERVICE_ROLE_KEY는 Supabase가 Edge Function에 주입합니다.
# 그 키와 WALLET_ENCRYPTION_KEY, 개인키는 클라이언트에 두지 않습니다.

# Sepolia ERC-20
# 주소가 없으면 보상 화면은 Demo Mode이고 잔액과 출석 보상을 표시하지 않습니다.
# 배포가 성공한 뒤에만 주소를 넣습니다. 배포 트랜잭션이 없으면 성공으로 두지 않습니다.
VITE_TOKEN_CONTRACT_ADDRESS=
# 비워 두면 viem 기본 Sepolia RPC로 ETH와 TNS 잔액을 읽습니다. 읽기에 실패하면 0으로 표시하지 않습니다.
VITE_SEPOLIA_RPC_URL=

# 서버 비밀. 브라우저 .env에 넣지 않습니다.
# supabase secrets set TOKEN_CONTRACT_ADDRESS='배포된 주소'
# supabase secrets set MINTER_PRIVATE_KEY='발행 지갑 개인키'
# supabase secrets set SEPOLIA_RPC_URL='https://...'
# MINTER_PRIVATE_KEY는 토큰 Owner 지갑입니다. 사용자 지갑 키와 다릅니다.

# Google Maps JavaScript API + Places API (New)
# 키가 없으면 코트 화면은 Demo Mode이고 지도와 검색을 실행하지 않습니다.
# 키에는 HTTP 리퍼러 제한과 API 제한(Maps JavaScript API, Places API (New))을 적용합니다.
VITE_GOOGLE_MAPS_API_KEY=
